{
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/tratament-ceramic-auto-:city.html",
      "destination": "/tratament-ceramic-auto-:city",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tratament-ceramic-auto-:city",
      "destination": "/tratament-ceramic-auto-:city.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/:slug.html"
    }
  ]
}